//startconfig
//id=de.icab.autorefresh


//title=Auto Refresh
//description=The module automatically reloads the web page after a certain time. When enabling the autorun setting, the page will continue to reload automatically, otherwise it will only reload once. When the confirmation setting is disabled, you have to call the module manually to enable the automatic reload for a web page. The setting is saved in a cookie for each web site individually.
//description.de=Das Modul lädt die Seite automatisch nach einer bestimmten Zeit neu. Wenn die Option "Automatisch starten" aktiv ist, lädt die Seite immer wieder nach Ablauf der eingestellten Zeit neu, ansonsten nur einmal. Sofern die "Ausführungsbestätigung" abgeschaltet ist, muß man das Modul manuell aufrufen, um das automatische Neuladen für eine Seite zu aktivieren. Das Neuladen wird pro Web-Seite in einem Cookie gespeichert.
//var=confirmation;type=confirmation;default=true;
//var=autostart;type=autorun;default=false;
//var=time;type=select;valuetitles=10 sec|20 sec|30 sec|1 min|2 min|5 min|10 min|15 min|30 min;values=10|20|30|60|120|300|600|900|1800;title=Reload after;title.de=Neu laden nach;default=60
//var=language;type=language;
//endconfig


function setCookie() {
	var date = new Date();
	var expiryDate = date.getTime() + (365 * 24 * 60 * 60 * 1000);
	date.setTime(expiryDate);
	document.cookie = "iCabAutoRefresh=YES;expires=" + date.toGMTString();
}

function hasCookie() {
	var cookies = document.cookie;
	return (cookies && cookies.indexOf("iCabAutoRefresh=YES") >= 0);
}

var doAction = hasCookie() && ((confirmation == false) || autostart) || ((confirmation == false) && (autostart == false));

if (doAction == false) {
	if (confirmation) {
		var text = "Do you want to let the page reload every "+time+" seconds?";
		if (language == "de") {
			text = "Soll die Web-Seite alle "+time+" Sekunden neu geladen werden?";
		}
		doAction = confirm(text);
	}
}

if (doAction) {
	setCookie();
	window.setTimeout("location.reload()",time*1000);
}

