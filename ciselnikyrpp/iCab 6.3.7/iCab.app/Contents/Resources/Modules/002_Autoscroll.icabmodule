//startconfig
//type=feature
//id=de.icab.autoscroll


//title=Autoscroll Page
//title.de=Automatisches Scrollen
//title.ru=Автопрокрутка
//description=Scrolls the web page automatically.
//description.de=Scrollt die Web-Seite automatisch.
//description.ru=Прокручивает веб-страницу автоматически.
//var=confirmation;type=confirmation;default=false;
//var=autostart;type=autorun;default=false;
//var=language;type=language;
//var=ctrl;type=bool;default=false;title=Controller;title.ru=Контроллер;
//var=speed;type=select;valuetitles=very slow|slow|medium|fast|very fast;valuetitles.de=sehr langsam|langsam|mittel|schnell|sehr schnell;valuetitles.ru=очень медленно|медленно|средне|быстро|очень быстро;values=0|1|2|3|4;title=Speed;title.de=Geschwindigkeit;title.ru=Скорость;default=2
//endconfig


var doAction = (confirmation == false);
var controller = null;
var stop = false;
var yOffset = 0;

if (confirmation) {
	var text = "Do you want to enable automatic scrolling?";
	if (language == "de") {
		text = "Möchten Sie das automatische Scrollen aktivieren?";
	} else if (language == "ru") {
		text = "Вы хотите включить автоматическую прокрутку?";
	}
	doAction = confirm(text);
}

function scrollPage() {
	var xOffset = window.pageXOffset;
	var yoff = window.pageYOffset;
	if (stop) {
		setTimeout("scrollPage()",1000);
    } else {
        var delta = 1;
        if (speed > 4) {
            delta = speed - 3;
        }
        if (yoff-5 < yOffset && yOffset <= yoff+5) {
            yOffset += delta;
        } else {
            yOffset = yoff + delta;
        }
		window.scrollTo(xOffset, yOffset);
		var t = 300;
		switch (speed) {
			case 0:		t = 200;	break;
			case 1:		t = 70;		break;
			case 2:		t = 30;		break;
			case 3:		t = 15;		break;
			default:	t = 5;		break;
		}
		setTimeout("scrollPage()",t);
	}
    if (controller) {
        controller.style.top = (yoff + 3) + "px";
        controller.style.left = (xOffset + window.innerWidth - 57 - 8) + "px";
    }
}

function createController() {
	controller = document.createElement('div');
	controller.style.position = 'absolute';
    controller.style.zIndex = '100000';
	controller.style.width = '55px';
//	controller.style.height = '30px';
	controller.style.backgroundColor = 'rgba(8,8,8,0.5)';
	controller.style.fontSize = '25px';
	controller.style.left = '0';
	controller.style.top = '0';
	controller.style.color = '#fff';
	controller.style.margin = '0';
	controller.style.padding = '4px';
	controller.innerHTML='<input style="width:40px;height:35px;padding:0;margin:4px;display:inline;float:none;top:0;left:0;" type="button" onclick="stop=false;if (speed<6)speed++" value="+"><br><input style="width:40px;height:35px;padding:0;margin:4px;display:inline;float:none;top:0;left:0;" type="button" onclick="stop=!stop" value="X"><br><input style="width:40px;height:35px;padding:0;margin:4px;display:inline;float:none;top:0;left:0;" type="button" onclick="stop=false;if (speed>0) speed--" value="-">';
	document.body.appendChild(controller);
}


if (doAction) {
	if (ctrl) createController();
	scrollPage();
}
