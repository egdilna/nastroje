//endconfig

function iCabMobileGetLayoutStyleSheet(doc, create) {
	var styleSheets = doc.styleSheets;
	if (styleSheets && styleSheets.length) {
		for (var i=0; i<styleSheets.length; i++) {
			var rules = styleSheets[i].rules;
			if (rules && rules.length) {
				var rule = rules[0].cssText;
				if (rule.toLowerCase().indexOf(".icabmobile") == 0) {
					return doc.styleSheets[i];
				}
			}
		}
	}
	if (create) {
		doc.getElementsByTagName("head")[0].appendChild(doc.createElement("style"));
		return styleSheets[styleSheets.length-1];
	}
	return 0;
}

function iCabMobileSetBlackAndWhite() {
	var styleSheet = iCabMobileGetLayoutStyleSheet(document,true);
	if (styleSheet && styleSheet.rules) {
		for (var i=0; i<styleSheet.rules.length; i++) {
			var rule = styleSheet.rules[i].cssText;
			if (rule.toLowerCase().indexOf(".icabmobilecolor") == 0) {
				styleSheet.removeRule(i);
				break;
			}
		}
		if (colorscheme == 0) {
			styleSheet.insertRule(".iCabMobileColor,*{color:black!important;background-color:white!important;}",0);		
			if (linktype) {
				styleSheet.insertRule(".iCabMobileColor,a[href] {color:#000088!important;}",1); 	
			}
		} else {
			styleSheet.insertRule(".iCabMobileColor,*{color:white!important;background-color:black!important;}",0);		
			if (linktype) {
				styleSheet.insertRule(".iCabMobileColor,a[href] {color:#ffff88!important;}",1); 	
			}
		}
	}
}

var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to set the colors of the web page to black & white?";
	if (language == "de") {
		text = "Wollen Sie die Farben der Web-Seite auf schwarz/weiß ändern?";
	} if (language == "it") {
		text = "Vuoi impostare i colori della pagina in bianco e nero?";
	}
	doAction = confirm(text);
}

if (doAction) {
	iCabMobileSetBlackAndWhite();
}
