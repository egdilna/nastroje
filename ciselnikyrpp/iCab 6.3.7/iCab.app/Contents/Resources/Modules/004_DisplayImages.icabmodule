//startconfig
//type=feature
//id=de.icab.displayimages


//title=Display all Images
//title.de=Alle Bilder zeigen
//title.ru=Показать изобр.
//toolbar=true
//description=Display all images of the current page.
//description.de=Zeigt alle Bilder der aktuellen Seite an.
//description.ja=ページ内の画像を全て表示。
//description.ru=Данный модуль показывать все изображения текущей страницы.
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Display all images of the page?";
	if (language == "de") {
		text = "Alle Bilder der Seite zeigen?";
	} else if (language == "ja") {
		text = "このページの画像を表示しますか?";
	} else if (language == "ru") {
		text = "Показать все изображения страницы?";
	}
	doAction = confirm(text);
}

if (doAction) {
    var size = 250;
    var src = '<head><title>'+document.title+'</title><style>';
    src += 'a{position:relative;width:'+size+'px;height:'+size+'px;display:inline-block;overflow:hidden;text-align:center;vertical-align:middle;margin:2pt;text-decoration:none;border:1px solid #555;background-color:#777;}';
    src += 'a:before{content:" ";vertical-align:middle;display:inline-block;width:0px;height:'+size+'px;overflow:hidden;}';
    src += 'img{vertical-align:middle;max-width:'+size+'px;max-height:'+size+'px;display:inline-block;}';
    src += 'iframe{visibility:hidden;}';
    src += 'span{position:absolute;white-space:nowrap;font-size:xx-small;font:sans-serif;color:#000;bottom:0;right:0;background-color:rgba(255,255,255,0.6);padding:0 2px;border:1px solid rgba(200,200,200,0.6);}';
    src += '</style></head><body style="-webkit-touch-callout:none">';

    var allImages = new Array();

	for (var i=0;i<document.images.length;i++){
        var href = document.images[i].src;
        var w = document.images[i].naturalWidth;
        var h = document.images[i].naturalHeight;
        if (allImages.indexOf(href) < 0) {
            src += '<a href="'+href+'" target="_blank"><img src="'+href+'"><span>('+w+' x '+h+')</span></a>';
            allImages.push(href);
        }
	}

	if (allImages.length > 0) {
        document.body.innerHTML = '<center>'+src+'</center>'
	} else {
		var text = "No images found!";
		if (language == "de") {
			text = "Keine Bilder gefunden!";
		} else if (language == "ru") {
			text = "Изображения не найдены!";
		}
		window.alert(text);
	}
}
