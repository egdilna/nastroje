//startconfig
//type=feature
//id=de.icab.scrollbottom


//title=Scroll to the Bottom
//title.de=Nach unten scrollen
//title.ru=Прокр. до конца
//toolbar=true
//description=The module scrolls to the bottom of the web page
//description.de=Das Modul scrollt die Web-Seite ganz nach unten
//description.ru=Данный модуль прокручивает веб-страницу до конца, к самому её низу
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to scroll to the bottom of the page?";
	if (language == "de") {
		text = "Wollen Sie ganz nach unten scrollen?";
	} else if (language == "ru") {
		text = "Вы хотите прокрутить страницу до конца вниз?";
	}
	doAction = confirm(text);
}

if (doAction) {
	window.scroll(0,document.body.scrollHeight);
}
