//startconfig
//type=feature
//id=de.icab.scrolltop


//title=Scroll to Top
//title.de=Nach oben scrollen
//title.ru=Прокрутить к началу
//toolbar=true
//description=The module scrolls to the top of the web page
//description.de=Das Modul scrollt die Web-Seite ganz nach oben
//description.ru=Данный модуль прокручивает веб-страницу к началу, самому её верху
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to scroll to the top?";
	if (language == "de") {
		text = "Wollen Sie nach oben scrollen?";
	} else if (language == "ru") {
		text = "Вы хотите прокрутить страницу до конца вверх?";
	}
	doAction = confirm(text);
}

if (doAction) {
	window.scroll(0,0);
}
