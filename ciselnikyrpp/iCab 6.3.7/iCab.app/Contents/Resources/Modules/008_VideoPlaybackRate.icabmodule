//startconfig
//type=feature
//id=de.icab.playbackRate


//title=Video Playback Rate
//toolbar=true
//description=Changes the playback rate of video playback for HTML 5 videos
//description.de=Ändert die Video-Abspielgeschwindigkeit von HTML 5-Videos
//var=language;type=language;
//endconfig


function iCabMobileChangePlaybackRate(v) {
	var videoElements = document.getElementsByTagName("video");
	for (var i=0; i<videoElements.length; i++) {
		var video = videoElements[i];
		video.playbackRate = parseFloat(v);
	}
}


var text = "Playback rate…";
if (language == "de") {
	text = "Abspielgeschwindigkeit…";
}
openPrompt(text,"0.25x|0.5x|0.75x|1x|1.25x|1.5x|2x|3x","iCabMobileChangePlaybackRate");



