//startconfig
//type=feature
//id=de.icab.youtube.embed


//title=YouTube Fullscreen
//description=The module redirects to the "embedded" YouTube player, removing all page clutter, displaying the video only (usually also without ads)
//description.de=Das Modul leitet auf den "embedded" YouTube-Player, entfernt alles außer dem Video (meist auch die Werbung)
//var=language;type=language;
//endconfig

var pos = location.href.indexOf(".youtube.com/watch?v=");
if (pos >= 0) {
	var id = location.href.substring(pos+21);
	pos = id.indexOf("&");
	if (pos > 0) {
		id = id.substring(0,pos)
	}
	openURL("https://www.youtube-nocookie.com/embed/" + id);
}

