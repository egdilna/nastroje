//startconfig
//type=tool
//id=de.icab.firebug


//title=Firebug Lite
//description=The module opens the Firebug Lite debugging tool for web pages. More information on http://getfirebug.com/firebuglite/.
//description.ru=Данный модуль открывает инструмент для отладки веб-страниц Firebug Lite. Более подробная информация на сайте http://getfirebug.com/firebuglite/.
//var=autostart;type=autorun;default=false;
//var=language;type=language;
//var=confirmation;type=confirmation;default=false;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to start Firebug Lite?";
	if (language == "de") {
		text = "Wollen Sie Firebug Lite starten?";
	} else if (language == "ru") {
		text = "Вы хотите запустить Firebug Lite?";
	}
	doAction = confirm(text);
}


if (doAction) {
	if (!(document.getElementById('FirebugLite'))) {
		var ns = document.createElementNS && document.documentElement.namespaceURI;
		var script = ns ? document.createElementNS(ns,'script') : document.createElement('script');
		script.setAttribute('id','FirebugLite');
		script.setAttribute('src','https://www.clauss-net.de/firebug-lite.js#startOpened');
		script.setAttribute('FirebugLite','4');
		(document.getElementsByTagName('head')[0]||document.getElementsByTagName('body')[0]).appendChild(script);
        var img = new Image;
		img.setAttribute('src','https://www.clauss-net.de/firebug-lite/skin/xp/sprite.png');
	}
}
