//startconfig
//id=com.quixapp.quix


//title=Quix
//description=Quix is an extensible bookmarklet, that allows you to easily access all your bookmarks and bookmarklets, across all your browsers, while maintaining them in only one spot.
//description.ru=Quix - это расширяемый букмарклет, который позволяем вам с лёгкостью получать доступ ко всем вашим закладкам и букмарклетам во всех ваших веб-браузерах, сохраняя их в одном месте.
//var=language;type=language;
//var=commandfile;type=string;default=http://quixapp.com/quix.txt;title=Command File;title.ru=Файл команд;
//endconfig

var text_prompt = "Quix: Type `help` for a list of commands:";
if (language == "ru") {
	text_prompt = "Quix: наберите `help` для получения списка команд:";
}

function Quix() {
	var e = encodeURIComponent;
	var t = window.getSelection?window.getSelection():(document.getSelection?document.getSelection():(document.selection?document.selection.createRange().text:''));
	var c = window.prompt(text_prompt);
	if (t != '') {
		if (c) {
			c += ' ' + t;
		} else {
			c = '' + t;
		}
	}
	if (c) {
		var u = 'http://www.quixapp.com/go/?c=' + e(c) + '&t=' + (document.title?e(document.title):'') + '&s=' + commandfile + '&v=081&u=' + (document.location?e(document.location):'');
		d = '' + document.location;
		if (d.substr(0,4) != 'http') {
			window.location = u + '&mode=direct';
		} else {
			heads = document.getElementsByTagName('head');
			if (c.substring(0,1)==' ') {
				var w = window.open(u + '&mode=direct');
				w.focus();
			} else if (heads.length == 0) {
				window.location = u + '&mode=direct';
			} else {
				q = document.getElementById('quix');
				if (q) {
					q.parentNode.removeChild(q);
				}
				sc = document.createElement('script');
				sc.src = u;
				sc.id = 'quix';
				sc.type = 'text/javascript';
				void(heads[0].appendChild(sc));
			}
		}
	}
}

Quix();
