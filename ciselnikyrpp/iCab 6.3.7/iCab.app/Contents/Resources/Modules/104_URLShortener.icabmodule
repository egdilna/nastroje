//startconfig
//id=de.icab.urlshortener


//title=URL Shortener
//title.de=URL-Verkürzer
//description=Creates a short URL for the web page.
//description.de=Erzeugt eine kurze URL für die Seite. 
//var=confirmation;type=confirmation;default=true;
//var=language;type=language;
//var=service;type=select;title=URL Shortener;title.de=URL-Verkürzer;values=0|1|3|4;valuetitles=ux.nu|mcaf.ee|TinyURL|is.gd;default=2;
//endconfig

var short_url = location.href;
var alert_confirm = "Do you want to create a short URL for the page?";
var alert_shorturl = "Error creating short URL!";
var alert_result = "Here's the short URL...";
if (language == "de") {
	alert_confirm = "Möchten Sie eine kurze URL dieser Seite erzeugen?";
	alert_shorturl = "Fehler beim erzeugen der kurzen URL!";
	alert_result = "Hier ist die kurze URL...";
}

function iCabMobileShowShortURL() {
	prompt(alert_result,short_url);
}


function iCabMobileUxNuShortURLFinished(status,data) {
	if (status / 100 < 4) {
		var pos = data.indexOf("http://ux.nu");
		if (pos > 0) {
			data = data.substr(pos);
			pos = data.indexOf("\"");
			short_url = data.substr(0,pos);
		} else {
			pos = data.indexOf("http:\\/\\/ux.nu\\/");
			if (pos > 0) {
				data = data.substr(pos+16);
				pos = data.indexOf("\"");
				short_url = "http://ux.nu/"+data.substr(0,pos);
			}
		}
	} else {
		alert(alert_shorturl + "(" + status + ")");
	}
	iCabMobileShowShortURL();
}

function iCabMobileMcAfeeShortURLFinished(status,data) {
	if (status / 100 < 4) {
		var pos = data.indexOf("http://mcaf.ee");
		if (pos > 0) {
			data = data.substr(pos);
			pos = data.indexOf("\"");
			short_url = data.substr(0,pos);
		}
	} else {
		alert(alert_shorturl + "(" + status + ")");
	}
	iCabMobileShowShortURL();
}

function iCabMobileTinyURLFinished(status,data) {
	if (status / 100 < 4) {
		short_url = data;
	} else {
		alert(alert_shorturl + "(" + status + ")");
	}
	iCabMobileShowShortURL();
}

function iCabMobileGoogleShortURLFinished(status,data) {
	if (status / 100 < 4) {
		var pos = data.indexOf("id=\"result\"");
		if (pos >= 0) {
			pos += 11;
			data = data.substr(pos);
			pos = data.indexOf("value=\"");
			if (pos >= 0) {
				pos += 7;
				data = data.substr(pos);
				pos = data.indexOf("\"");
				short_url = data.substr(0,pos);
			}
		} else {
			var pos = data.indexOf("url=http://goo.gl/");
			if (pos > 0) {
				pos += 4;
				data = data.substr(pos);
				pos = data.indexOf("&");
				short_url = data.substr(0,pos);
			}
		}
	} else {
		alert(alert_shorturl + "(" + status + ")");
	}
	iCabMobileShowShortURL();
}

function iCabMobileBitlyShortURLFinished(status,data) {
	if (status / 100 < 4) {
		pos = data.indexOf("<a class=\"short_url\" href=\"http://bit.ly/");
		if (pos >= 0) {
			pos += 27;
		}
		if (pos > 0) {
			data = data.substr(pos);
			pos = data.indexOf("\"");
			short_url = data.substr(0,pos);
		}
	} else {
		alert(alert_shorturl + "(" + status + ")");
	}
	iCabMobileShowShortURL();
}


function iCabBitlyStart(status,data) {
	if (status / 100 < 4) {
		var pos = data.indexOf("name=\"_xsrf\" value=\"");
		var id = "";
		if (pos > 0) {
			pos += 20;
			data = data.substr(pos);
			pos = data.indexOf("\"");
			id = "&_xsrf="+data.substr(0,pos);
		}	
		postRequest("https://bitly.com/","url="+encodeURIComponent(location.href)+id+"&searchButton=Shorten&basic_style=1&classic_mode=&rapid_shorten_mode=","iCabMobileBitlyShortURLFinished");
		return;
	} else {
		alert(alert_shorturl + "(" + status + ")");
	}
}

var doAction = true;
if (confirmation) {
	doAction = confirm(alert_confirm);
}

if (doAction) {
	switch (service) {
		case 0:	//ux.nu
			getRequest("http://ux.nu/api/short?url="+encodeURIComponent(location.href),"iCabMobileUxNuShortURLFinished");
			break;
		case 1:	//mcaf.ee
			getRequest("http://mcaf.ee/api/shorten?input_url="+encodeURIComponent(location.href),"iCabMobileMcAfeeShortURLFinished");
			break;
		case 2:	//goo.gl
			postRequest("http://goo.gl/action/shorten","url="+encodeURIComponent(location.href)+"&security_token=","iCabMobileGoogleShortURLFinished");	
			break;
		case 3:	//TinyURL
			getRequest('http://tinyurl.com/api-create.php?url='+encodeURIComponent(location.href),"iCabMobileTinyURLFinished");
			break;
		case 4:	//is.gd
			getRequest('http://is.gd/create.php?format=simple&url='+encodeURIComponent(location.href),"iCabMobileTinyURLFinished");
			break;
		case 5:	//bit.ly
			getRequest("https://bitly.com/","iCabBitlyStart");
			break;
	}
}
