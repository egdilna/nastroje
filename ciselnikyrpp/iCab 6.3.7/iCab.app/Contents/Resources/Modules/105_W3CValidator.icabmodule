//startconfig
//id=de.icab.w3cvalidator


//title=W3C Validator
//description=The module allows you to check the HTML code of the page for errors using the Validator service of the W3C. More information on http://validator.w3.org/
//description.de=Das Modul erlaubt es den HTML-Code von Web-Seiten auf Fehler zu untersuchen. Das Modul nutzt den Service des W3C. Weitere Informationen gibt es auf http://validator.w3.org/
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to check the HTML code of the page using the W3C Validator?";
	if (language == "de") {
		text = "Wollen Sie den HTML-Code der Seite über den W3C-Validator prüfen?";
	}
	doAction = confirm(text);
}

if (doAction) {
	window.open('http://validator.w3.org/check?uri='+encodeURIComponent(location.href));
}
