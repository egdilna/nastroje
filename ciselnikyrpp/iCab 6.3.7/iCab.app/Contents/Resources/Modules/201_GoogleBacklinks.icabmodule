//startconfig
//id=de.icab.backlinks


//title=Links to page
//title.de=Verweise auf Seite
//title.it=Link a questa pagina
//description=Searches for web pages which link to the currently displayed web page (via Google)
//description.de=Sucht nach Web-Seiten, die auf die aktuell angezeigte Seite verweisen (via Google)
//description.it=Riporta le pagine web i cui link portano a questa (ricerca tramite Google)
//var=confirmation;type=confirmation;default=true;
//var=language;type=language;
//endconfig

var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to search for Web pages which are linking to this web page (via Google)?";
	if (language == "de") {
		text = "Möchten Sie über Google nach Webseiten suchen, die auf diese Web-Seite verweisen?";
	} else if (language == "it") {
		text = "Vuoi ricercare (tramite Google) le pagine web che hanno link alla pagina visualizzata?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var url = "http://www.google.com/search?as_lq="+encodeURIComponent(location.href);
	location.href = url;
}

