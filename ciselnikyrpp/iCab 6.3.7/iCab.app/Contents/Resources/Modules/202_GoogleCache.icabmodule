//startconfig
//id=de.icab.googlecache


//title=Google Cache
//description=Loads the cached version of a web page from google.
//description.de=Lädt die Fassung der Web-Seite aus dem Google-Cache.
//description.it=Carica la versione cache (su Google) di una pagina web
//var=confirmation;type=confirmation;default=true;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to load the cached version of this page from Google?";
	if (language == "de") {
		text = "Möchten Sie die Version dieser Seite aus dem Google-Cache laden?";
	} else if (language == "it") {
		text = "Vuoi caricare l'ultima versione della pagina memorizzata nella cache di Google?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var url = "http://www.google.com/search?q=cache:"+encodeURIComponent(location.href);
	location.href = url;
}
