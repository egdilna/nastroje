//startconfig
//id=de.icab.ePubConverter


//title=Convert to ePub
//title.de=In ePub konvertieren
//title.es=Convertir a ePub
//title.ca=Convertir a ePub
//title.ru=Преобр. в ePub
//description=Converts the current page to ePub e-book format using the dotEPUB service. Module by Vladimir Sizikov, Xavier Badosa, Alexander Clauss.
//description.de=Konvertiert eine Web-Seite in ein eBook im ePub-Format und nutzt dabei den Service von dotEPUB. Modul von Vladimir Sizikov, Xavier Badosa, Alexander Clauss
//description.es=Convierte la página actual al formato de e-book ePub usando el servicio dotEPUB. Módulo por Vladimir Sizikov, Xavier Badosa, Alexander Clauss.
//description.ca=Converteix la pàgina actual al format d'e-book ePub utilitzant el servei dotEPUB. Mòdul per Vladimir Sizikov, Xavier Badosa, Alexander Clauss.
//description.ru=Данный модуль конвертирует текущую страницу в формат электронной книги ePub, используя сервис dotEPUB. Авторы модуля: Владимир Сизиков, Ксавьер Бадоса, Александр Клаусс.
//var=confirmation;type=confirmation;default=false;
//var=s;type=boolean;title=Keep links and images;title.de=Links und Bilder behalten;title.ru=Сохр. ссылки и изображения;default=false;
//var=language;type=language;
//var=out_lang;type=select;valuetitles=English|Español|Català;values="en"|"es"|"ca";title=Output Language;title.de=Zielsprache;title.ru=Язык вывода;default="en";
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to convert this page to ePub format?";
	if (language == "ru") {
		text = "Вы хотите конвертировать эту страницу в формат ePub?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var d = document;
	try {
		if(!d.body || d.body.innerHTML == '') {
			throw(0);
		}
		if(out_lang!='en' && out_lang!='es' && out_lang!='ca') {
			out_lang='en';
		}
		var dotEPUBcss = d.createElement('link');
		dotEPUBcss.rel = 'stylesheet';
		dotEPUBcss.href = 'http://dotepub.com/s/dotEPUB-favlet.css';
		dotEPUBcss.type = 'text/css';dotEPUBcss.media='screen';
		d.getElementsByTagName('head')[0].appendChild(dotEPUBcss);
		dotEPUBstatus = d.createElement('div');
		dotEPUBstatus.setAttribute('id','dotepub');
		
		if (language == "ru") {
			dotEPUBstatus.innerHTML = '<div id="status"><p>преобразование...</p></div>';
		} else {
			dotEPUBstatus.innerHTML = '<div id="status"><p>working...</p></div>';
		}
		
		d.body.appendChild(dotEPUBstatus);
 
		var dotEPUB = d.createElement('script');
		dotEPUB.type = 'text/javascript';
		dotEPUB.charset = 'utf-8';
		dotEPUB.src = 'http://dotepub.com/j/dotepub.js?x='+(Math.random());
		dotEPUB_links = s ? 1 : 0;
		dotEPUB_lang = out_lang;
		d.getElementsByTagName('head')[0].appendChild(dotEPUB);
	} catch(e) {
		if (language == "ru") {
			alert('Страница не имеет содержимого или загрузилась не полностью. Пожалуйста, подождите, пока страница загрузится.');
		} else {
			alert('The page has no content or it is not fully loaded. Please, wait till the page is loaded.');
		}
	}
}
