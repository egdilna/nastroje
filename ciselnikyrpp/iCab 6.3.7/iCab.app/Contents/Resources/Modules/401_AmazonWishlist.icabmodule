var doAction = (confirmation == false);


if (doAction == false) {
	if (confirmation) {
		var text = "Do you want to start the Amazon Whishlist module?";
		if (language == "de") {
			text = "Wollen Sie das Amazon Wunschzettel-Modul starten?";
		}
		doAction = confirm(text);
	}
}


if (doAction) {
    if (!tld || tld.length == 0) tld = "com";
    if (tld.indexOf(".") == 0) tld = tld.substr(1);
