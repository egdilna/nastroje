//startconfig
//type=store
//id=de.icab.camelcamelcamel


//title=CamelCamelCamel - Amazon price history
//title.de=CamelCamelCamel - Amazon Preis-Verlauf
//description=Dieses Modul leitet auf den Dienst CamelCamelCamel um, der den Verlauf des Verkaufspreises eines Amazon-Produkts anzeigt. Rufen Sie das Modul hierfür direkt von einer Produktseite der Amazon-Site auf.
//description.de=This module uses the service CamelCamelCamel to show the price history for an Amazon product. Please call this module from within a product page of the Amazon web site.
//var=confirmation;type=confirmation;default=false;
//var=tld;type=string;default=com;title=Amazon Domain;title.ru=Домен Amazon;
//var=language;type=language;
//endconfig

if (location.host.indexOf("amazon.") >= 0) {
	var doAction = (confirmation == false);

	if (doAction == false) {
		if (confirmation) {
			var text = "Do you want to see the price history for the product?";
			if (language == "de") {
				text = "Wollen Sie den Preisverlauf für das Produkt sehen?";
			}
			doAction = confirm(text);
		}
	}

	if (doAction) {
		window.open("http://camelcamelcamel.com/search?sq="+encodeURI(location.href));
	}
	
} else {
	var text = "Please call this module for an Amazon product page!";
	if (language == "de") {
		text = "Bitte rufen Sie dieses Modul nur für eine Amazon-Produktseite auf?";
	}
	alert(text);
}
