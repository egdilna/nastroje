//startconfig
//id=de.icab.diigo


//title=Diigo
//description=This module posts the web page in Diigo. The simple mode only posts on Diigo, in normal mode there are also features like notes and highlighting available, but which require a larger screen, so the normal mode might have issues on the iPhone.
//description.de=Das Modul postet die Web-Seite auf Diigo. Der einfache Modus beschränkt sich auf das Posten auf Diigo, der Normal-Modus erlaubt auch Notizen und Hervorhebungen, benötigt aber einen größeren Bildschirm, und es kann auf dem iPhone daher manchmal zu eng werden.
//description.ru=Данный модуль позволяет отправлять веб-страницу в Diigo. Простой режим производит только отправку в Diigo, в нормальном режиме есть также функционал заметок и подсветки, но он требует наличия большего экран, поэтому у нормального режима могут быть проблемы на iPhone.
//var=confirmation;type=confirmation;default=false;
//var=simple;type=bool;title=Simple Mode;title.de=Einfacher Modus;title.ru=Простой режим;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want post the page on Diigo?";
	if (language == "de") {
		text = "Wollen Sie Seite auf Diigo posten?";
	} else if (language == "ru") {
		text= "Вы хотите отправить страницу в Diigo?";
	}
	doAction = confirm(text);
}

if (doAction) {
    if (simple) {
        var url = location.href;
        var title = document.title || url;
        var desc = (window.getSelection ? window.getSelection().toString() : document.getSelection ? document.getSelection() : document.selection.createRange().text);
        window.open('http://www.diigo.com/post?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title) + '&desc=' + encodeURIComponent(desc)+'&client=simplelet#main','_blank');
    } else {
        var s=document.createElement('script');
        s.type='text/javascript';
        s.src='http://www.diigo.com/javascripts/webtoolbar/diigolet_b_h_ipad.js';
        document.body.appendChild(s);
    }
}
