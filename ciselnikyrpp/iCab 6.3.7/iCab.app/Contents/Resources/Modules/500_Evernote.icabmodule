//startconfig
//type=service
//id=net.aramzamzam.icab.evernote


//title=Evernote
//description=The module saves the web page to Evernote
//description.ru=Данный модуль позволяет сохранить веб-страницу в Evernote
//var=language;type=language;
//var=confirmation;type=confirmation;default=false;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to start Evernote?";
	if (language == "de") {
		text = "Wollen Sie Evernote starten?";
	} else if (language == "ru") {
		text = "Вы хотите запустить Evernote?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var EN_CLIP_HOST='https://www.evernote.com';
	try{
		var x=document.createElement('SCRIPT');
		x.type='text/javascript';
		x.src=EN_CLIP_HOST+'/public/bookmarkClipper.js?'+(new Date().getTime()/100000);
		document.getElementsByTagName('head')[0].appendChild(x);
	}catch(e){
		location.href=EN_CLIP_HOST+'/clip.action?url='+encodeURIComponent(location.href)+'&title='+encodeURIComponent(document.title);
	}
}
