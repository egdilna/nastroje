var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want share the page on Facebook?";
	if (language == "de") {
		text = "Wollen Sie Seite auf Facebook posten?";
	} else if (language == "ru") {
		text = "Вы хотите поделиться страницей в Facebook?";
	}
	doAction = confirm(text);
}

function StartFacebook() {
	var d=document;
	var f='http://www.facebook.com/share';
	var l=d.location;
	var e=encodeURIComponent;
	var p='.php?src=bm&v=4&i=1302556053&u='+e(l.href)+'&t='+e(d.title);
	try {
		if (!/^(.*\.)?facebook\.[^.]*$/.test(l.host)) {
			throw(0);
		}
		share_internal_bookmarklet(p)
	} catch(z) {
		if (!window.open(f+'r'+p,'sharer','toolbar=0,status=0,resizable=1,width=626,height=436')) {
			l.href=f+p;
		}
	}
}

function LoginFinished(status,data) {
	StartFacebook();
}

String.prototype.unescapeHtml = function () {
    var temp = document.createElement("div");
    temp.innerHTML = this;
    var result = temp.childNodes[0].nodeValue;
    temp.removeChild(temp.firstChild);
    return result;
}

function getValue(tag, attr) {
	attr += "=\"";
	var pos = tag.indexOf(attr);
	if (pos >= 0) {
		tag = tag.substr(pos + attr.length);
		pos = tag.indexOf("\"");
		if (pos >= 0) {
			tag = tag.substr(0,pos);
			if (tag.length > 0) {
				return tag.unescapeHtml();
			}
		}
	}
	return "";
}

function HomePageLoaded(status, data) {
	var pos = data.indexOf("id=\"login_form\"");
	if (pos < 0) {
		pos = data.indexOf("action=\"https://www.facebook.com/login");
	}
	if (pos > 0) {
		while (pos > 0 && data.substr(pos,6) != "<form ") pos--;
		data = data.substr(pos);
		pos = data.indexOf("</form>");
		if (pos > 0) {
			data = data.substr(0,pos);
			var request = "";
			var action = "";
			pos = data.indexOf("action=\"");
			if (pos > 0) {
				action = data.substr(pos+8);
				pos = action.indexOf("\"");
				if (pos > 0) {
					action = action.substr(0,pos);
					
					pos = data.indexOf("<input");
					while (pos >= 0) {
						var tag = data.substr(pos);
						var pos2 = tag.indexOf(">");
						if (pos2 > 0) {
							tag = tag.substr(0,pos2);
							data = data.substr(pos2);
							
							var name = getValue(tag, "name");
							var value = getValue(tag, "value");
							if (name == "email") value = username;
							if (name == "pass") value = password;
							if (value.length) {
								if (request.length > 0) {
									request += "&";
								}
								request += name + "=" + encodeURIComponent(value);
							}
							
						} else {
							break;
						}
						pos = data.indexOf("<input");
					}
					if (action.length > 0 && request.length > 0) {
						postRequest(action, request, "LoginFinished");
						return;
					}
				}
			}			
		}
	}
	StartFacebook();	
}

if (doAction) {
	if (username && password && username.length > 0 && password.length > 0) {
		getRequest("http://www.facebook.com/","HomePageLoaded");
	
	} else {
		StartFacebook();
	}
}
