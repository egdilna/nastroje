//startconfig
//id=de.icab.InstaReadLater


//title=Add Page To Instapaper
//title.de=Seite in Instapaper speichern
//title.ru=Доб. в Instapaper
//description=Saves the current page to your Instapaper account (More info at http://www.instapaper.com).
//description.de=Speichert die aktuelle Seite in Ihrem Instapaper-Konto (Mehr Infor auf http://www.instapaper.com)
//description.ru=Данный модуль сохраняет текущую страницу в вашу учётную запись Instapaper. Более подробно на сайте http://www.instapaper.com/.
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//var=username;type=string;title=Name;title.ru=Логин;
//var=password;type=password;title=Password;title.de=Passwort;title.ru=Пароль;
//endconfig


if (username == "") {
		var text = "You must configure your Instapaper account credentials in this module settings before using!";
		if (language == "de") {
			text = "Sie müssen zuerst Ihre Instapaper-Konto-Daten (Name, Passwort) in den Modul-Einstellungen eingeben, bevor sie das Modul nutzen können!";
		} else if (language == "ru") {
			text = "Вы должны настроить данные вашей учётной записи Instapaper в настройках этого модуля перед его использованием!";
		}
		alert(text);
	
} else {
	var doAction = (confirmation == false);
	
	if (confirmation) {
		var text = "Do you want to save the current page in your Instapaper account?";
		if (language == "de") {
			text = "Möchten Sie aktuelle Seite in Ihrem Instapaper-Konto speichern?";
		} else if (language == "ru") {
			text = "Вы хотите сохранить текущую страницу в вашу учётную запись Instapaper?";
		}
		doAction = confirm(text);
	}

	function InstapaperResponse(status,data) {
		var text = "Error when adding the page to Instapaper";
		if (language == "de") {
			text = "Fehler beim speichern der Webseite bei Instapaper";
		} else if (language == "ru") {
			text = "Ошибка при добавлении страницы в Instapaper";
		}
		if (status == 201) {
			text = "Web page successfully saved to your Instapaper account.";
			if (language == "de") {
				text = "Speichern der Web-Seite bei Instapaper war erfolgreich.";
			} else if (language == "ru") {
				text = "Веб-страница успешно добавлена в вашу учётную запись Instapaper.";
			}
		} else if (status == 403) {
			text = "Instapaper Error: Invalid username or password!";
			if (language == "de") {
				text = "Instapaper-Fehler: Name oder Passwort ist falsch!";
			} else if (language == "ru") {
				text = "Ошибка Instapaper: неверный логин или пароль!";
			}
		}
		alert(text);
	}
	
	if (doAction) {
		var url = "https://www.instapaper.com/api/add?url="+encodeURIComponent(location.href);
		var title = document.title;
		if (title != "") url += "&title="+encodeURIComponent(title);
		if (username != "") url += "&username="+encodeURIComponent(username);
		if (password != "") url += "&password="+encodeURIComponent(password);
		location.href = "modulerequest://InstapaperResponse/?url="+encodeURIComponent(url);
	}
}
