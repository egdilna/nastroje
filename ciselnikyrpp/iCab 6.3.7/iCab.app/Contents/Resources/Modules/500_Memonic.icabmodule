//startconfig
//id=de.icab.memomic


//title=Memomic
//description=The module saves the web page to Memomic
//description.ru=Данный модуль позволяет сохранить веб-страницу в Memomic
//var=language;type=language;
//var=confirmation;type=confirmation;default=false;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to start Memomic?";
	if (language == "de") {
		text = "Wollen Sie Memomic starten?";
	} else if (language == "ru") {
		text = "Вы хотите запустить Memomic?";
	}
	doAction = confirm(text);
}

if (doAction) {
	try{
		var d=document;
		var j='http://www.memonic.com/bookmarklet/clipper.js';
		var js='https://www.memonic.com/bookmarklet/clipper.de.js';
		var x=d.createElement('script');
		x.type='text/javascript';
		if (location.protocol == 'https:') {
			x.src=js;
		} else {
			x.src=j;
		}
		d.body.appendChild(x);
	} catch(e) {
		alert('Please wait until the page has loaded.');
	}
}
