//startconfig
//id=net.voodoojello.pinboard


//title=Bookmark on Pinboard
//title.ru=Закладка в Pinboard
//description=Saves the current page URL in your Pinboard bookmarks via the Pinboard bookmarklet interface. See http://pinboard.in/howto/ for more info.
//description.ru=Данный модуль сохраняет URL текущей страницы в ваших закладках Pinboard с помощью интерфейса букмарклетов Pinboard. Более подробно на сайте http://pinboard.in/howto/.
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Add to your Pinboard bookmarks?";
	if (language == "ru") {
		text = "Добавить к вашим закладкам в Pinboard?";
	}
	doAction = confirm(text);
	}

if (doAction) {
	q=location.href;if(document.getSelection){d=document.getSelection();}else{d='';};p=document.title;void(open('https://pinboard.in/add?url='+encodeURIComponent(q)+'&description='+encodeURIComponent(d)+'&title='+encodeURIComponent(p),'Pinboard','toolbar=no,width=700,height=350'));
}
