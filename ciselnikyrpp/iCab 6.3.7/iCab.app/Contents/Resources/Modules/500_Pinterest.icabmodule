//startconfig
//id=de.icab.pinterest


//title=Pinterest
//description=The module saves pictures from the web page to Pinterest
//description.de=Das Modul speichert Bilder der Seite auf Pinterest
//description.ru=Данный модуль сохраняет изображения из веб-страницы в Pinterest
//var=language;type=language;
//var=confirmation;type=confirmation;default=false;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to save pictures to Pinterest?";
	if (language == "de") {
		text = "Wollen Sie Bilder der Web-Seite auf Pinterest posten?";
	} else if (language == "ru") {
		text = "Вы хотите сохранить изображения в Pinterest?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var e=document.createElement('script');
	e.setAttribute('type','text/javascript');
	e.setAttribute('charset','UTF-8');
	e.setAttribute('src','http://assets.pinterest.com/js/pinmarklet.js?r='+Math.random()*99999999);
	document.body.appendChild(e);
}
