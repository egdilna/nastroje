//startconfig
//id=de.icab.pocket


//title=Pocket
//description=Saves the current page to your Pocket account (More info at http://getpocket.com/).
//description.de=Speichert die aktuelle Seite in Ihrem Pocket-Konto (Mehr Info auf http://getpocket.com/)
//description.ru=Данный модуль сохраняет текущую страницу в вашу учётную запись Pocket. Более подробно на сайте http://getpocket.com/.
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//var=username;type=string;title=Name;title.ru=Логин;
//var=password;type=password;title=Password;title.de=Passwort;title.ru=Пароль;
//endconfig


if (username == "" || password == "") {
		var text = "You must configure your Pocket (or ReadItLater) account credentials in this module settings before using!";
		if (language == "de") {
			text = "Sie müssen zuerst Ihre Pocket (oder ReadItLater) Konto-Daten (Name, Passwort) in den Modul-Einstellungen eingeben, bevor sie das Modul nutzen können!";
		} else if (language == "ru") {
			text = "Вы должны настроить данные вашей учётной записи Pocket (или ReadItLater) в настройках данного модуля перед его использованием!";
		}
		alert(text);
	
} else {
	var doAction = (confirmation == false);
	
	if (confirmation) {
		var text = "Do you want to send this URL to your Pocket account?";
		if (language == "de") {
			text = "Möchten Sie die URL an Ihren Pocket Account senden?";
		} else if (language == "ru") {
			text = "Вы хотите отправить этот URL в вашу учётную запись Pocket?";
		}
		doAction = confirm(text);
	}
	
	function ReadItLaterResponse(status,data) {
		if (status == 200) {
			text = "Web page successfully saved to your Pocket account.";
			if (language == "de") {
				text = "Speichern der Web-Seite bei Pocket war erfolgreich.";
			} else if (language == "ru") {
				text = "Веб-страница была успешно сохранена в вашу учётную запись Pocket.";
			}
		} else if (status == 400) {
			text = "Pocket Error: Invalid request";
			if (language == "de") {
				text = "Pocket-Fehler: Invalid request";
			} else if (language == "ru") {
				text = "Ошибка Pocket: неверный запрос";
			}
		} else if (status == 401) {
			text = "Pocket Error: Invalid username or password!";
			if (language == "de") {
				text = "Pocket-Fehler: Name oder Passwort ist falsch!";
			} else if (language == "ru") {
				text = "Ошибка Pocket: неверный логин или пароль!";
			}
		} else if (status == 403) {
			text = "Pocket Error: Rate limit exceeded";
			if (language == "de") {
				text = "Pocket-Fehler: Rate limit exceeded";
			} else if (language == "ru") {
				text = "Ошибка Pocket: превышено ограничение частоты запросов";
			}
		} else if (status == 503) {
			text = "Pocket Error: Read It Later's sync server is down for scheduled maintenance.";
			if (language == "de") {
				text = "Pocket-Fehler: Read It Later's sync server is down for scheduled maintenance.";
			} else if (language == "ru") {
				text = "Ошибка Pocket: сервер синхронизации ReadItLater временно отключен для проведения запланированных работ.";
			}
		}
		alert(text);
	}
	
	if (doAction) {
		var url = "https://readitlaterlist.com/v2/add?username="+encodeURIComponent(username);
		url += "&password="+encodeURIComponent(password);
		url += "&apikey=838p8IMYAcq34B54aNg09f5qd9dVYa43";
		url += "&url="+encodeURIComponent(location.href);
		url += "&title="+encodeURIComponent(document.title);
		
		location.href = "modulerequest://ReadItLaterResponse/?url="+encodeURIComponent(url);
	}
}
