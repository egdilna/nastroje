//startconfig
//id=de.icab.scoopit


//title=Scoop It
//description=The module adds the current web page to Scoop It
//description.de=Das Modul fügt die Seite zu Scoop It hinzu
//description.ru=Данный модуль добавляет текущую веб-страницу в Scoop It
//var=language;type=language;
//var=confirmation;type=confirmation;default=false;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to add the page to Scoop It?";
	if (language == "de") {
		text = "Wollen Sie die Seite zu Scoop It hinzufügen?";
	} else if (language == "ru") {
		text = "Вы хотите добавить страницу в Scoop It?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var scscript=document.createElement('SCRIPT');
	scscript.type='text/javascript';
	scscript.src='https://www.scoop.it/resources/bklet/scoop.js?x='+(Math.random());
	document.getElementsByTagName('head')[0].appendChild(scscript);
	document.sc_srvurl='https://www.scoop.it';
}
