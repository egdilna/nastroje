//startconfig
//id=de.icab.stumbleupon


//title=StumbleUpon
//description=The module saves the web page to StumbleUpon <http://stumbleupon.com>
//var=language;type=language;
//var=confirmation;type=confirmation;default=false;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want to save the page in StumbleUpon?";
	if (language == "de") {
		text = "Wollen Sie die Seite in StumbleUpon speichern?";
	}
	doAction = confirm(text);
}


if (doAction) {
    document.location.href='http://www.stumbleupon.com/submit?url='+encodeURIComponent(location.href)+'&title='+encodeURIComponent(document.title);
}
