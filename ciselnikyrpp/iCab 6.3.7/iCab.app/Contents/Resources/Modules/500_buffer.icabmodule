//startconfig
//id=de.icab.buffer


//title=Buffer
//description=This module adds the page to your Buffer account. Further information at http://bufferapp.com/
//description.de=Das Modul fügt die Web-Seite zu ihren Buffer-Konto hinzu. Nähere Infos auf http://bufferapp.com/
//description.ru=Этот модуль добавляет страницу в вашу учётную запись Buffer. Более подробно на http://bufferapp.com/
//var=confirmation;type=confirmation;default=false;
//var=language;type=language;
//endconfig


var doAction = (confirmation == false);

if (confirmation) {
	var text = "Do you want add the page to your Buffer account?";
	if (language == "de") {
		text = "Möchten Sie die Seite zu ihren Buffer-Konto hinzufügen?";
	} else if (language == "ru") {
		text = "Вы хотите добавить страницу в вашу учётную запись Buffer?";
	}
	doAction = confirm(text);
}

if (doAction) {
	var a=document.getElementsByTagName('head')[0];
	var b=document.createElement('script');
	b.type='text/javascript';
	b.src='http://bufferapp.com/js/bookmarklet.v1.js?'+Math.floor(Math.random()*99999);
	a.appendChild(b);
}
